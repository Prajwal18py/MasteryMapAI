GROQ_API_KEY=
MISTRAL_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-small-latest
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
